{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "paths": {
    "@/*": ["./src/client/*"],
    "@server/*": ["./src/server/*"],
    "@shared/*": ["./src/shared/*"]
  },
  "ignore": [
    "sip-bridge/**",
    "signal-notifier/**",
    "site/**",
    "crypto-sandbox/**",
    "deploy/docker/tests/**",
    "benchmarks/**",
    "vendor/**",
    "drizzle/migrations/*.integration.test.ts",
    "tests/live/**",
    "src/client/routeTree.gen.ts",
    "public/fonts/**",
    "public/worklets/**",
    "playwright.docker.config.ts",
    "playwright.vm.config.ts"
  ],
  "ignoreDependencies": [
    "jssip",
    "plivo-browser-sdk",
    "sonner"
  ]
}
