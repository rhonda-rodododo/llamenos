# Llamenos Docker Compose — managed by Ansible
# Do not edit directly; changes will be overwritten on next deploy.

name: llamenos

services:
  # ── Core ──────────────────────────────────────────────────
  app:
    image: {{ llamenos_image }}
    restart: unless-stopped
    read_only: true
    tmpfs:
      - /tmp:size=64M
    env_file:
      - .env
{% if app_environment | default('production') == 'development' %}
    ports:
      - "3000:3000"
{% endif %}
    networks:
      - web
      - internal
    depends_on:
      postgres:
        condition: service_healthy
      rustfs:
        condition: service_healthy
      strfry:
        condition: service_healthy
      authentik-server:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/api/health/live"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    deploy:
      resources:
        limits:
          memory: 1G
    labels:
      com.centurylinklabs.watchtower.enable: "true"

  postgres:
    image: {{ postgres_image }}
    restart: unless-stopped
    volumes:
      - postgres-data:/var/lib/postgresql/data
      - ./postgres-init:/docker-entrypoint-initdb.d:ro
    command: ["postgres", "-c", "max_connections={{ pg_max_connections | default(1000) }}"]
    environment:
      - POSTGRES_DB=llamenos
      - POSTGRES_USER=llamenos
      - POSTGRES_PASSWORD={{ pg_password }}
    networks:
      - internal
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U llamenos -d llamenos"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  caddy:
    # Tier 4 PR-A: the caddy container bakes in dist/client (served on
    # {{ llamenos_app_domain }}) and dist/crypto-sandbox (served on
    # {{ llamenos_crypto_domain }}). API requests still reverse-proxy to
    # app:3000 on {{ llamenos_api_domain }}. One Caddy process terminates
    # TLS for all three origins via the multi-site Caddyfile.
    image: {{ llamenos_static_image }}
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    networks:
      - web
      - internal  # Required for reverse_proxy to strfry (Nostr relay)
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    depends_on:
      app:
        condition: service_healthy
    labels:
      com.centurylinklabs.watchtower.enable: "true"

  rustfs:
    image: {{ rustfs_image | default('rustfs/rustfs:latest') }}
    command: server /data
    restart: unless-stopped
    volumes:
{% if luks_enabled | default(false) | bool %}
      - {{ luks_mount_path | default('/var/data/rustfs') }}:/data
{% else %}
      - rustfs-data:/data
{% endif %}
    environment:
      - RUSTFS_ACCESS_KEY={{ storage_access_key }}
      - RUSTFS_SECRET_KEY={{ storage_secret_key }}
      - RUSTFS_CONSOLE_ENABLE=true
    networks:
      - internal
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://127.0.0.1:9000/health"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s

  strfry:
    image: dockurr/strfry:1.0.1
    restart: unless-stopped
    ulimits:
      nofile:
        soft: 1000000
        hard: 1000000
    volumes:
      - nostr-data:/app/strfry-db
    networks:
      - internal
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:7777"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
  # ── Identity Provider (Authentik) ─────────────────────────────
  authentik-server:
    image: {{ authentik_image | default('ghcr.io/goauthentik/server:2025.12') }}
    command: server
    restart: unless-stopped
    environment:
      - AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}
      - AUTHENTIK_POSTGRESQL__HOST=postgres
      - AUTHENTIK_POSTGRESQL__PORT=5432
      - AUTHENTIK_POSTGRESQL__USER=llamenos
      - AUTHENTIK_POSTGRESQL__PASSWORD={{ pg_password }}
      - AUTHENTIK_POSTGRESQL__NAME=authentik
      - AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_bootstrap_token }}
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - internal
    volumes:
      - authentik-media:/media
      - authentik-templates:/templates
      - ./authentik-blueprints:/blueprints/custom:ro
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD", "ak", "healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

  authentik-worker:
    image: {{ authentik_image | default('ghcr.io/goauthentik/server:2025.12') }}
    command: worker
    restart: unless-stopped
    environment:
      - AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}
      - AUTHENTIK_POSTGRESQL__HOST=postgres
      - AUTHENTIK_POSTGRESQL__PORT=5432
      - AUTHENTIK_POSTGRESQL__USER=llamenos
      - AUTHENTIK_POSTGRESQL__PASSWORD={{ pg_password }}
      - AUTHENTIK_POSTGRESQL__NAME=authentik
      - AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_bootstrap_token }}
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - internal
    volumes:
      - authentik-media:/media
      - authentik-templates:/templates
      - ./authentik-blueprints:/blueprints/custom:ro
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

{% if watchtower_enabled | default(false) %}

  # ── Optional: Watchtower (Auto-Updates) ─────────────────────

  watchtower:
    image: {{ watchtower_image | default('containrrr/watchtower:1.7.1') }}
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      - WATCHTOWER_LABEL_ENABLE=true
      - WATCHTOWER_POLL_INTERVAL={{ watchtower_poll_interval | default(86400) }}
      - WATCHTOWER_CLEANUP=true
      - WATCHTOWER_LOG_LEVEL=${WATCHTOWER_LOG_LEVEL:-info}
      - REPO_USER=${GHCR_USERNAME:-}
      - REPO_PASS=${GHCR_TOKEN:-}
    logging:
      driver: json-file
      options:
        max-size: "5m"
        max-file: "3"
    security_opt:
      - no-new-privileges:true
{% endif %}
{% if 'transcription' in (compose_profiles | default([])) %}

  whisper:
    image: {{ whisper_image | default('fedirz/faster-whisper-server:0.4.1') }}
    restart: unless-stopped
    environment:
      - WHISPER__MODEL={{ whisper_model | default('Systran/faster-whisper-base') }}
      - WHISPER__DEVICE={{ whisper_device | default('cpu') }}
    networks:
      - internal
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
{% endif %}
{% if 'asterisk' in (compose_profiles | default([])) %}

  asterisk:
    image: {{ asterisk_image | default('andrius/asterisk:20') }}
    restart: unless-stopped
    volumes:
      - asterisk-config:/etc/asterisk
    networks:
      - internal
    healthcheck:
      test: ["CMD", "asterisk", "-rx", "core show version"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s

  sip-bridge:
    image: {{ llamenos_image }}
    command: ["bun", "run", "sip-bridge/index.ts"]
    restart: unless-stopped
    environment:
      - ARI_URL=ws://asterisk:8088/ari/events
      - ARI_USERNAME={{ ari_username | default('llamenos') }}
      - ARI_PASSWORD={{ ari_password }}
      - WORKER_WEBHOOK_URL=http://app:3000
      - BRIDGE_SECRET={{ bridge_secret }}
    networks:
      - internal
    depends_on:
      asterisk:
        condition: service_healthy
      app:
        condition: service_healthy
{% endif %}
{% if 'kamailio' in (compose_profiles | default([])) %}

  kamailio:
    image: {{ kamailio_image | default('kamailio/kamailio:5.7') }}
    restart: unless-stopped
    ports:
      - "{{ kamailio_sip_port | default(5060) }}:5060/udp"
      - "{{ kamailio_sip_port | default(5060) }}:5060/tcp"
{% if kamailio_tls_enabled | default(false) | bool %}
      - "{{ kamailio_sip_tls_port | default(5061) }}:5061/tcp"
{% endif %}
    volumes:
      - ./kamailio/kamailio.cfg:/etc/kamailio/kamailio.cfg:ro
      - ./kamailio/dispatcher.list:/etc/kamailio/dispatcher.list:ro
{% if kamailio_tls_enabled | default(false) | bool %}
      - ./kamailio/tls:/etc/kamailio/tls:ro
{% endif %}
    networks:
      - internal
{% if 'asterisk' in (compose_profiles | default([])) %}
    depends_on:
      asterisk:
        condition: service_healthy
{% endif %}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD", "kamcmd", "core.version"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
{% endif %}
{% if 'signal' in (compose_profiles | default([])) %}

  signal-cli:
    image: {{ signal_image | default('bbernhard/signal-cli-rest-api:0.92') }}
    restart: unless-stopped
    environment:
      - MODE=json-rpc
    volumes:
      - signal-data:/home/.local/share/signal-cli
    networks:
      - internal
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/v1/about"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
{% endif %}

volumes:
  postgres-data:
  caddy-data:
  caddy-config:
{% if not (luks_enabled | default(false) | bool) %}
  rustfs-data:
{% endif %}
  nostr-data:
  authentik-media:
  authentik-templates:
{% if 'asterisk' in (compose_profiles | default([])) %}
  asterisk-config:
{% endif %}
{% if 'signal' in (compose_profiles | default([])) %}
  signal-data:
{% endif %}

networks:
  web:
    driver: bridge
  internal:
    driver: bridge
    internal: true
