# Caddyfile for Llamenos — managed by Ansible
# Do not edit directly; changes will be overwritten on next deploy.
#
# Tier 4 PR-A split-origin layout:
#   {{ llamenos_app_domain }}     — SPA static bundle
#   {{ llamenos_api_domain }}     — Hono backend + /nostr WebSocket
#   {{ llamenos_crypto_domain }}  — sandboxed crypto iframe
#
# Cookies scoped to the API origin with SameSite=Strict; app.* and api.*
# share the registrable parent so cross-origin XHR remains same-site.
{% set tls = tls_mode | default('acme') %}
{% if tls != 'off' %}
{
	email {{ acme_email }}
}
{% endif %}

# ─── SPA origin — {{ llamenos_app_domain }} ─────────────────────────
{% if tls == 'off' %}
:80 {
{% elif tls == 'internal' %}
{{ llamenos_app_domain }} {
	tls internal
{% else %}
{{ llamenos_app_domain }} {
{% endif %}
	root * /srv/app
	encode gzip zstd
	file_server
	try_files {path} /index.html

	header {
		# Strict SPA CSP — only self-hosted JS/CSS + crypto iframe + API.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://{{ llamenos_api_domain }} wss://{{ llamenos_api_domain }}; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; frame-src https://{{ llamenos_crypto_domain }}; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'; trusted-types llamenos default; report-uri https://{{ llamenos_api_domain }}/api/csp-report; upgrade-insecure-requests"

		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
{% if tls != 'off' %}
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
{% endif %}
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Permitted-Cross-Domain-Policies "none"
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
		-Server
	}
}

# ─── API origin — {{ llamenos_api_domain }} ─────────────────────────
{% if tls == 'off' %}
:81 {
{% elif tls == 'internal' %}
{{ llamenos_api_domain }} {
	tls internal
{% else %}
{{ llamenos_api_domain }} {
{% endif %}
	encode gzip zstd

	# Nostr relay WebSocket proxy — single allowed WSS host in SPA CSP.
	handle /nostr {
		reverse_proxy strfry:7777
	}

	# Everything else → Hono backend.
	handle {
		reverse_proxy app:3000
	}

	header {
		# The Hono securityHeaders middleware already emits a hard
		# default-src 'none'; script-src 'none' CSP on every response.
		# Caddy-level headers are belt-and-suspenders for routes that
		# bypass middleware (e.g. health probes served by Caddy).
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "cross-origin"
{% if tls != 'off' %}
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
{% endif %}
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# ─── Crypto sandbox origin — {{ llamenos_crypto_domain }} ────────────
{% if tls == 'off' %}
:82 {
{% elif tls == 'internal' %}
{{ llamenos_crypto_domain }} {
	tls internal
{% else %}
{{ llamenos_crypto_domain }} {
{% endif %}
	root * /srv/crypto
	encode gzip zstd
	file_server
	try_files {path} /sandbox.html

	header {
		# Iframe-only CSP. HARD INVARIANT: `connect-src 'none'` — the crypto
		# sandbox is an offline oracle. Ciphertext flows in via postMessage,
		# plaintext flows out via postMessage. ZERO network. Never widen this
		# to 'self' or api.*; doing so would break the Tier 4 threat model.
		# `style-src 'self'` matches the sandbox.html meta CSP (no inline
		# styles are used, but `'none'` forbids even the <link rel=stylesheet>
		# we ship in the bundle). `script-src` adds 'wasm-unsafe-eval' so
		# noble/whisper WASM modules can instantiate once crypto wiring lands.
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors https://{{ llamenos_app_domain }}; require-trusted-types-for 'script'; trusted-types llamenos-sandbox default; report-uri https://{{ llamenos_api_domain }}/api/csp-report"

		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		# CORP must be 'cross-origin' — the SPA host sets COEP: require-corp,
		# which means the iframe fetch must opt in via CORP: cross-origin.
		# frame-ancestors restricts who can embed; CORP allows the fetch to
		# succeed. 'same-origin' would block the cross-origin iframe load.
		Cross-Origin-Resource-Policy "cross-origin"
{% if tls != 'off' %}
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
{% endif %}
		X-Content-Type-Options "nosniff"
		# frame-ancestors (above) replaces X-Frame-Options — {{ llamenos_app_domain }}
		# must be allowed to iframe this origin, so X-Frame-Options:DENY would be wrong.
		Referrer-Policy "no-referrer"
		X-Permitted-Cross-Domain-Policies "none"
		-Server
	}
}
