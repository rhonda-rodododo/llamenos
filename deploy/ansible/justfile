# Llamenos Ansible Deployment Commands
#
# Prerequisites:
#   - Ansible installed (pip install ansible)
#   - just installed (https://github.com/casey/just)
#   - inventory.yml and vars.yml configured
#
# Quick start:
#   cp inventory.example.yml inventory.yml
#   cp vars.example.yml vars.yml
#   # Edit both files with your values
#   ansible-vault encrypt vars.yml
#   just setup-all

# Default recipe: show available commands
default:
    @just --list

# Full server setup: harden + deploy
setup-all *ARGS:
    ansible-playbook setup.yml --ask-vault-pass {{ARGS}}

# Harden the server (SSH, firewall, kernel, fail2ban, Docker)
harden *ARGS:
    ansible-playbook playbooks/harden.yml --ask-vault-pass {{ARGS}}

# Deploy or update the application
deploy *ARGS:
    ansible-playbook playbooks/deploy.yml --ask-vault-pass {{ARGS}}

# Pull latest images and restart with health check and rollback
update *ARGS:
    ansible-playbook playbooks/update.yml --ask-vault-pass {{ARGS}}

# Run encrypted backup
backup *ARGS:
    ansible-playbook playbooks/backup.yml --ask-vault-pass {{ARGS}}

# Check configuration without making changes
check *ARGS:
    ansible-playbook setup.yml --check --diff --ask-vault-pass {{ARGS}}

# Validate playbooks without making changes (CI-safe, uses example inventory and vars)
validate *ARGS:
    ansible-lint .
    ansible-playbook setup.yml --check --diff \
        -i inventory.example.yml \
        --extra-vars "@vars.example.yml" \
        {{ARGS}}

# Show what would change on the server (requires vault password)
dry-run *ARGS:
    ansible-playbook setup.yml --check --diff --ask-vault-pass {{ARGS}}

# Encrypt the vars file with Ansible Vault
encrypt-vars:
    ansible-vault encrypt vars.yml

# Edit encrypted vars file
edit-vars:
    ansible-vault edit vars.yml

# View encrypted vars file
view-vars:
    ansible-vault view vars.yml

# Test SSH connectivity to all hosts
ping:
    ansible all -m ping

# Show gathered facts for debugging
facts:
    ansible all -m setup --ask-vault-pass

# Install galaxy roles + collections from requirements.yml
# Run once after a fresh checkout, then re-run when requirements.yml changes
bootstrap:
    ansible-galaxy install -r requirements.yml -p roles/galaxy/ --upgrade
    ansible-galaxy collection install -r requirements.yml --upgrade

# Deploy or update the demo instance
deploy-demo *ARGS:
    ansible-playbook playbooks/deploy-demo.yml --ask-vault-pass {{ARGS}}

# Reset demo data on demand
reset-demo *ARGS:
    ansible-playbook playbooks/reset-demo.yml --ask-vault-pass {{ARGS}}

# Roll back demo to a specific image tag (e.g.: just rollback-demo v1.2.3)
rollback-demo version *ARGS:
    ansible-playbook playbooks/deploy-demo.yml --ask-vault-pass \
        --extra-vars "llamenos_image=ghcr.io/llamenos/llamenos:{{version}}" \
        {{ARGS}}

# Run an encrypted backup of the demo instance
backup-demo *ARGS:
    ansible-playbook playbooks/backup.yml --ask-vault-pass -l demo {{ARGS}}

# Test that the latest demo backup can be restored
test-restore-demo *ARGS:
    ansible-playbook playbooks/test-restore.yml --ask-vault-pass -l demo {{ARGS}}

# Restore a specific backup to the demo database (e.g.: just restore-demo s3:bucket/llamenos-20260101-030000.sql.gz.age)
restore-demo backup_file *ARGS:
    ansible-playbook playbooks/restore.yml --ask-vault-pass -l demo \
        --extra-vars "restore_backup_file={{backup_file}}" \
        {{ARGS}}

# Encrypt the demo vars file
encrypt-demo-vars:
    ansible-vault encrypt demo_vars.yml

# Edit encrypted demo vars file
edit-demo-vars:
    ansible-vault edit demo_vars.yml

# ─── Local VM Testing (Tart on Mac) ──────────────────────────────
# Requires: Tart + Docker on Mac, SSH access as 'mac'
# See: docs/plans/2026-03-25-local-vm-ansible-testing.md

# Multi-distro Tart matrix test. Provisions a fresh VM per image, runs the
# hardening playbook, executes smoke assertions via Ansible, then tears down.
#
# P0 distros (must pass on every PR): Ubuntu 24.04, Debian 13
# P1 distros (nightly + tags):        Ubuntu 22.04, Debian 12
# all:                                everything above
#
# Bootstrap: cirruslabs Tart images ship with default user `admin` (password
# `admin`), no pre-injected SSH keys, and broken DNS (Tart's IPv6 link-local
# resolver doesn't work). The recipe handles all three: copies the operator's
# Mac SSH key as admin's authorized_keys via sshpass, then writes a static
# /etc/resolv.conf inside the VM so apt can reach archive.ubuntu.com /
# deb.debian.org.
#
# After hardening succeeds, the recipe reconnects on the new SSH port (2222)
# as the `deploy` user that the common role created, and runs
# playbooks/smoke-check.yml to assert ufw/fail2ban/docker/sshd state. This
# matches Plan 1's T15 merge gate exactly.
#
# Requires (on the Mac):
#   - Tart CLI on PATH (sourced via ~/.zprofile)
#   - sshpass (brew install sshpass)
#   - ~/.ssh/id_ed25519 with a passphrase-less key (the operator's existing
#     deploy key — same one used by `vm-deploy`)
#   - ~/llamenos-distro-test/ansible/ checked out with vars-local-vm.yml in
#     place. The wrapper recipe `test-matrix-sync` below rsyncs the current
#     working tree onto the Mac before running the matrix.
#
# Usage (from Mac, with `just` installed):
#   just test-matrix              # P0 only (default)
#   just test-matrix p1
#   just test-matrix all
#
# Usage (from any host that can `ssh mac`):
#   just test-matrix-sync         # rsync + run P0
test-matrix mode='p0':
    #!/usr/bin/env bash
    set -euo pipefail

    # cirruslabs publishes Debian images under codename tags only (trixie,
    # bookworm) — there are no numeric `:13`/`:12` tags. Ubuntu uses numeric.
    # Verified via `curl https://ghcr.io/v2/cirruslabs/{debian,ubuntu}/tags/list`.
    case "{{mode}}" in
      p0)  images=("ghcr.io/cirruslabs/ubuntu:24.04" "ghcr.io/cirruslabs/debian:trixie") ;;
      p1)  images=("ghcr.io/cirruslabs/ubuntu:22.04" "ghcr.io/cirruslabs/debian:bookworm") ;;
      all) images=(
            "ghcr.io/cirruslabs/ubuntu:24.04"
            "ghcr.io/cirruslabs/ubuntu:22.04"
            "ghcr.io/cirruslabs/debian:trixie"
            "ghcr.io/cirruslabs/debian:bookworm"
           ) ;;
      *)   echo "usage: just test-matrix [p0|p1|all]" >&2; exit 2 ;;
    esac

    REMOTE_DIR="${LLAMENOS_DISTRO_TEST_DIR:-$HOME/llamenos-distro-test/ansible}"
    SSH_KEY="${LLAMENOS_TART_SSH_KEY:-$HOME/.ssh/id_ed25519}"

    for image in "${images[@]}"; do
      slug="$(basename "$image" | tr ':' '-')"
      name="llamenos-test-${slug}"
      echo "=== Provisioning ${name} from ${image} ==="

      source ~/.zprofile
      tart stop "${name}" 2>/dev/null || true
      tart delete "${name}" 2>/dev/null || true
      tart clone "${image}" "${name}"
      tart set "${name}" --cpu 4 --memory 8192 --disk-size 20
      nohup tart run --no-graphics "${name}" >"/tmp/${name}.log" 2>&1 &
      disown

      echo "=== Waiting for ${name} to boot ==="
      vm_ip=""
      for i in $(seq 1 30); do
        sleep 3
        vm_ip="$(tart ip "${name}" 2>/dev/null || true)"
        [ -n "$vm_ip" ] && break
      done
      if [ -z "$vm_ip" ]; then
        echo "ERROR: ${name} never got an IP" >&2
        exit 1
      fi
      echo "=== ${name} reachable at ${vm_ip} ==="

      echo "=== Waiting for SSH on ${vm_ip}:22 ==="
      for i in $(seq 1 30); do
        if sshpass -p admin ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
            -o ConnectTimeout=3 admin@"${vm_ip}" "echo ready" >/dev/null 2>&1; then
          break
        fi
        sleep 3
      done

      echo "=== Bootstrapping SSH key + DNS on ${name} ==="
      sshpass -p admin ssh-copy-id -f \
        -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -i "${SSH_KEY}.pub" admin@"${vm_ip}" >/dev/null
      ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -i "${SSH_KEY}" admin@"${vm_ip}" \
        "sudo rm -f /etc/resolv.conf && printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' | sudo tee /etc/resolv.conf >/dev/null" \
        >/dev/null

      echo "=== Running harden playbook against ${name} ==="
      cd "${REMOTE_DIR}"

      # Build a per-run inventory FILE (not inline `-i ip,`) so Ansible
      # loads group_vars/all/ from the playbook directory. With inline
      # inventory Ansible only loads group_vars relative to the inventory
      # file's directory, which (with no file) means group_vars/all/docker.yml
      # (containing docker_daemon_options with userns-remap, no-new-privileges,
      # etc.) is silently dropped. We'd then test an unhardened default daemon.
      #
      # NOTE: just requires consistent recipe-body indentation, so we cannot
      # use a bare heredoc — its body lines would be at column 0 and just
      # would treat them as ending the recipe. Use `printf` instead.
      printf '%s\n' \
        'all:' \
        '  hosts:' \
        '    matrix-target:' \
        "      ansible_host: ${vm_ip}" \
        '      ansible_user: admin' \
        "      ansible_ssh_private_key_file: ${SSH_KEY}" \
        '      ansible_python_interpreter: /usr/bin/python3' \
        > tmp-matrix-inventory-admin.yml

      ANSIBLE_HOST_KEY_CHECKING=False ansible-playbook playbooks/harden.yml \
        -i tmp-matrix-inventory-admin.yml \
        --extra-vars '@vars-local-vm.yml'

      # Read the hardened SSH port from the test vars so the smoke-check
      # connects on the right port (vars-local-vm.yml uses 22 by default,
      # but operators can bump it to 2222 for closer-to-prod testing).
      hardened_port="$(awk '/^ssh_port:/ {print $2}' vars-local-vm.yml)"
      hardened_port="${hardened_port:-22}"

      printf '%s\n' \
        'all:' \
        '  hosts:' \
        '    matrix-target:' \
        "      ansible_host: ${vm_ip}" \
        '      ansible_user: deploy' \
        "      ansible_port: ${hardened_port}" \
        "      ansible_ssh_private_key_file: ${SSH_KEY}" \
        '      ansible_python_interpreter: /usr/bin/python3' \
        > tmp-matrix-inventory-deploy.yml

      echo "=== Running smoke checks against ${name} (port ${hardened_port}) ==="
      ANSIBLE_HOST_KEY_CHECKING=False ansible-playbook playbooks/smoke-check.yml \
        -i tmp-matrix-inventory-deploy.yml \
        --extra-vars '@vars-local-vm.yml'

      rm -f tmp-matrix-inventory-admin.yml tmp-matrix-inventory-deploy.yml

      echo "=== Tearing down ${name} ==="
      tart stop "${name}" 2>/dev/null || true
      tart delete "${name}"
      echo "=== ${image} PASS ==="
    done

    echo
    echo "=== test-matrix {{mode}} PASS for ${#images[@]} distro(s) ==="

# Sync the current working tree's deploy/ansible to the Mac and run the
# Tart matrix test there. Use this from the Linux workstation when iterating
# on the multi-distro hardening roles.
#
# Usage:
#   just test-matrix-sync          # P0
#   just test-matrix-sync p1
#   just test-matrix-sync all
test-matrix-sync mode='p0':
    #!/usr/bin/env bash
    set -euo pipefail
    REMOTE="${LLAMENOS_TART_HOST:-mac}"
    REMOTE_DIR="${LLAMENOS_DISTRO_TEST_DIR:-llamenos-distro-test/ansible}"
    echo "=== Syncing $(pwd) → ${REMOTE}:~/${REMOTE_DIR} ==="
    rsync -az --delete \
      --exclude='.ansible' \
      --exclude='vars.yml' \
      --exclude='inventory.yml' \
      ./ "${REMOTE}:${REMOTE_DIR}/"
    # Drop a stub vars.yml so include_vars: ../vars.yml succeeds; extra-vars
    # from vars-local-vm.yml has higher precedence and overrides everything.
    ssh "${REMOTE}" "echo '{}' > ${REMOTE_DIR}/vars.yml"
    # Copy the test vars file from the operator's existing checkout (the same
    # one `vm-deploy` uses) into the synced tree.
    ssh "${REMOTE}" "cp ~/projects/llamenos-hotline/deploy/ansible/vars-local-vm.yml ${REMOTE_DIR}/vars-local-vm.yml"
    echo "=== Running test-matrix {{mode}} on ${REMOTE} ==="
    ssh "${REMOTE}" "source ~/.zprofile && cd ${REMOTE_DIR} && just test-matrix {{mode}}"

# Create and configure a fresh Tart VM for testing (4 CPU / 8GB matches a small VPS)
vm-create:
    ssh mac 'source ~/.zprofile && tart clone ghcr.io/cirruslabs/ubuntu:24.04 llamenos-test && tart set llamenos-test --cpu 4 --memory 8192 --disk-size 20'

# Start the VM headless
vm-start:
    ssh mac 'source ~/.zprofile && tart run llamenos-test --no-graphics &'
    @echo "Waiting for VM to boot..."
    @sleep 10
    @ssh mac 'source ~/.zprofile && tart ip llamenos-test'

# Stop the VM
vm-stop:
    ssh mac 'source ~/.zprofile && tart stop llamenos-test'

# Destroy the VM
vm-destroy:
    ssh mac 'source ~/.zprofile && tart delete llamenos-test'

# Show VM IP
vm-ip:
    @ssh mac 'source ~/.zprofile && tart ip llamenos-test'

# SSH into the VM through the Mac (port 2222 after hardening)
vm-ssh:
    ssh -J mac -p 2222 deploy@$(ssh mac 'source ~/.zprofile && tart ip llamenos-test')

# Build the Docker image on the Mac (ARM64 native)
vm-build-image:
    ssh mac 'export PATH="/usr/local/bin:/opt/homebrew/bin:$$PATH" && cd ~/projects/llamenos-hotline && docker build -f deploy/docker/Dockerfile -t llamenos:local .'

# Load the built image into the VM (port 2222 after hardening)
vm-load-image:
    ssh mac 'source ~/.zprofile && export PATH="/usr/local/bin:$$PATH" && docker save llamenos:local | gzip | ssh -p 2222 deploy@$$(tart ip llamenos-test) "gunzip | sudo docker load"'

# Deploy to the VM using Ansible (run from Mac)
vm-deploy *ARGS:
    ssh mac 'cd ~/projects/llamenos-hotline/deploy/ansible && source ~/.zprofile && ansible-playbook setup.yml -i inventory-local-vm.yml --extra-vars "@vars-local-vm.yml" {{ARGS}}'

# Deploy only app changes (skip hardening)
vm-deploy-app *ARGS:
    ssh mac 'cd ~/projects/llamenos-hotline/deploy/ansible && source ~/.zprofile && ansible-playbook playbooks/deploy.yml -i inventory-local-vm.yml --extra-vars "@vars-local-vm.yml" {{ARGS}}'

# Update app (pull new image + restart with health check)
vm-update *ARGS:
    ssh mac 'cd ~/projects/llamenos-hotline/deploy/ansible && source ~/.zprofile && ansible-playbook playbooks/update.yml -i inventory-local-vm.yml --extra-vars "@vars-local-vm.yml" {{ARGS}}'

# Run E2E tests against the VM from the Mac
vm-test *ARGS:
    ssh mac 'export PATH="/usr/local/bin:/opt/homebrew/bin:$$PATH" && cd ~/projects/llamenos-hotline && npx playwright test --config playwright.vm.config.ts {{ARGS}}'

# Full cycle: build image, load into VM, deploy, run tests
vm-cycle:
    just vm-build-image
    just vm-load-image
    just vm-deploy-app
    just vm-test

# Snapshot the VM for fast iteration resets
vm-snapshot:
    ssh mac 'source ~/.zprofile && tart stop llamenos-test && tart clone llamenos-test llamenos-test-snapshot'
    @echo "Snapshot created. Restore with: just vm-restore"

# Restore VM from snapshot
vm-restore:
    ssh mac 'source ~/.zprofile && tart stop llamenos-test 2>/dev/null; tart delete llamenos-test 2>/dev/null; tart clone llamenos-test-snapshot llamenos-test'
    just vm-start

# Generate secrets for a new deployment
generate-secrets:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "=== Generated Secrets ==="
    echo ""
    echo "pg_password: $(openssl rand -base64 24)"
    echo "hmac_secret: $(openssl rand -hex 32)"
    echo "server_nostr_secret: $(openssl rand -hex 32)"
    echo "storage_access_key: $(openssl rand -base64 24)"
    echo "storage_secret_key: $(openssl rand -base64 24)"
    echo "jwt_secret: $(openssl rand -hex 32)"
    echo "idp_value_encryption_key: $(openssl rand -hex 32)"
    echo "authentik_secret_key: $(openssl rand -hex 32)"
    echo "authentik_bootstrap_token: $(openssl rand -hex 32)"
    echo "ari_password: $(openssl rand -base64 24)"
    echo "bridge_secret: $(openssl rand -base64 24)"
    echo ""
    echo "Copy these into your vars.yml before encrypting."
    echo "Run: just encrypt-vars"
