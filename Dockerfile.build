# Dockerfile.build — Canonical build environment for reproducible builds (Epic 79)
#
# This container produces deterministic output given the same source code.
# All verification builds MUST use this container (not bare metal) to ensure
# consistent Tailwind CSS ordering and build tool behavior.
#
# Usage:
#   docker build -f Dockerfile.build -t llamenos-build .
#   docker create --name extract llamenos-build
#   docker cp extract:/build/dist ./dist
#   docker rm extract
#
# CI sets SOURCE_DATE_EPOCH from git commit time for deterministic timestamps.
# Local builds default to epoch 0 (1970-01-01) for full reproducibility.

FROM oven/bun:1@sha256:8956c7667fa17beb6e3c664115e66bdacfe502da5d99603626e74c197bdef160

# Consistent locale (prevents locale-dependent output differences)
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Remove variable environment
ENV HOME=/build
ENV USER=build

# Default SOURCE_DATE_EPOCH for local builds (CI overrides via --build-arg)
ARG SOURCE_DATE_EPOCH=0
ARG GITHUB_SHA=local
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
ENV GITHUB_SHA=${GITHUB_SHA}

WORKDIR /build

# Install dependencies first (layer caching)
COPY package.json bun.lockb ./
# The @wireapp/core-crypto dependency is vendored as a `file:` dep; bun must
# be able to resolve it at install time or the whole install fails.
COPY vendor/ vendor/
RUN bun install --frozen-lockfile --ignore-scripts

# Copy source
COPY src/ src/
COPY public/ public/
COPY crypto-sandbox/ crypto-sandbox/
COPY scripts/verify-no-console.sh scripts/verify-no-console.sh
COPY index.html vite.config.ts tsconfig.json ./
COPY tailwind.config.ts* ./

# Upgrade OS packages to pick up security patches released after the base
# image was built (mirrors the production Dockerfile pattern).
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Build frontend (Vite + verify-no-console gate) — reads SOURCE_DATE_EPOCH and GITHUB_SHA
RUN bun run build

# Remove bun install cache — it contains Go binaries (esbuild, lefthook)
# compiled with older Go toolchains that accumulate Trivy CVE alerts.
# node_modules/ is used by the build; the cache is not.
RUN rm -rf .bun/install/cache/

# Switch away from root for the final image layer (Trivy DS-0002).
# This is a build-only container — never deployed — but the scan flags it.
USER 1000

# Output: /build/dist/client/
