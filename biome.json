{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "noConsole": "error"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "a11y": {
        "useButtonType": "warn",
        "useSemanticElements": "warn",
        "useFocusableInteractive": "warn",
        "noLabelWithoutControl": "warn",
        "useKeyWithClickEvents": "warn",
        "useAriaPropsForRole": "warn",
        "noSvgWithoutTitle": "warn",
        "noAutofocus": "warn",
        "useMediaCaption": "warn"
      },
      "complexity": {
        "noForEach": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/site",
      "!**/vendor",
      "!**/*.config.ts",
      "!**/*.config.js",
      "!**/*.config.mjs",
      "!**/public",
      "!**/.claude",
      "!**/src/client/routeTree.gen.ts"
    ]
  },
  "overrides": [
    {
      "includes": [
        "**/src/client/lib/debug-log.ts",
        "**/tests/**",
        "**/sip-bridge/**",
        "**/scripts/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/**/crypto*.ts",
        "**/src/**/hub-*.ts",
        "**/src/**/file-*.ts",
        "**/src/**/envelope-*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyBlockStatements": "error"
          }
        }
      }
    }
  ]
}
